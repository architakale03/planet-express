# Copy to .env. Values are dev defaults and work for both paths.
#
# This sits beside docker-compose.yml so Compose auto-reads it: a bare
# `docker compose up` picks up these values with no --env-file flag. The backend
# reads the same file, so one file configures both containers and the host path.

# --- Docker path (`make up`) -------------------------------------------------
# Compose interpolates these into docker-compose.yml.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=planet_express
POSTGRES_PORT=5432

# Host port the API is published on. Uvicorn still listens on 8000 inside the
# container — only the host side is remapped.
API_PORT=8080
APP_ENV=development
LOG_LEVEL=info

# --- Local path (`make dev`) -------------------------------------------------
# Read only when running on the host. Compose injects its own DATABASE_URL
# pointing at the `db` service, and real environment variables outrank this
# file, so this line has no effect inside a container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/planet_express
