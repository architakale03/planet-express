{
  // Point Pylance at the uv-managed virtualenv so imports resolve and the
  // "package is not installed" warnings on pyproject.toml go away.
  "python.defaultInterpreterPath": "${workspaceFolder}/api/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}/api"
}
